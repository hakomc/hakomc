{
  "compilerOptions": {
    "target": "es6",
    "moduleResolution": "Bundler",
    "module": "ES2020",
    "declaration": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": false,
    "pretty": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noImplicitUseStrict": false,
    "noEmit": true,
    "listFiles": false,
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./core/*"]
    }
  },
  "include": [
    "core/**/*",
    "vite-plugin/**/*",
    "tests/**/*",
  ],
  "exclude": [
    "node_modules",
    "dev/**/*"
  ],
  "compileOnSave": false
}
